<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fitsSystemWindows="true">

    <!-- ── Top app bar ── -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="@color/bg_surface">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="gloss"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.05" />

        <!-- Model status indicator -->
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="⬤  No model"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_lang_chip" />
    </LinearLayout>

    <!-- ── Scrollable body ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ── Language selector row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <!-- Source language spinner -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FROM"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spinnerSource"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_lang_chip"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center_vertical"
                        android:popupBackground="@color/bg_card_elevated" />
                </LinearLayout>

                <!-- Swap button -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="18dp">

                    <ImageButton
                        android:id="@+id/btnSwap"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_swap_btn"
                        android:src="@drawable/ic_swap"
                        android:contentDescription="Swap languages"
                        android:elevation="4dp" />
                </FrameLayout>

                <!-- Target language spinner -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TO"
                        android:textSize="10sp"
                        android:letterSpacing="0.12"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spinnerTarget"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_lang_chip"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center_vertical"
                        android:popupBackground="@color/bg_card_elevated" />
                </LinearLayout>

            </LinearLayout>

            <!-- ── Model download banner (shown when model not ready) ── -->
            <LinearLayout
                android:id="@+id/downloadBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/downloadBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Model not downloaded"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/downloadBannerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~30 MB · one-time download"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_download_btn"
                    android:text="Download"
                    android:textColor="@color/download_btn_text"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:drawableStart="@drawable/ic_download"
                    android:drawablePadding="6dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- ── Input card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/labelSource"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="English"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/accent_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />
                </LinearLayout>

                <EditText
                    android:id="@+id/inputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:gravity="top|start"
                    android:hint="@string/hint_input"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textSize="19sp"
                    android:textColor="@color/text_primary"
                    android:background="@null"
                    android:lineSpacingMultiplier="1.4"
                    android:cursorVisible="true" />

                <!-- Word tap result chip -->
                <TextView
                    android:id="@+id/wordTranslationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textStyle="italic"
                    android:textSize="14sp"
                    android:textColor="@color/word_chip_text"
                    android:background="@drawable/bg_word_chip"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Connector / arrow divider ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="1dp"
                    android:layout_height="8dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="↓"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="@color/accent_secondary"
                    android:background="@drawable/bg_swap_btn" />

                <!-- Reusing circular bg, we'll override tint in code if needed -->
                <!-- Actually we'll just draw a teal circle here -->
            </LinearLayout>

            <!-- ── Output card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/labelTarget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Spanish"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/accent_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCopyOutput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/outputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:gravity="top|start"
                    android:hint="Translation will appear here…"
                    android:textSize="19sp"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:lineSpacingMultiplier="1.4"
                    android:background="@null" />

            </LinearLayout>

            <!-- ── Status bar ── -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
